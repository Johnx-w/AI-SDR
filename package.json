{
  "name": "shadeflow-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "schema:prepare": "node --env-file-if-exists=.env scripts/migrate-business-schema.mjs prepare",
    "schema:finalize": "node --env-file-if-exists=.env scripts/migrate-business-schema.mjs finalize",
    "business:provision": "node --env-file-if-exists=.env scripts/provision-customer-business.mjs",
    "test": "node --test tests/*.test.mjs",
    "preflight:native": "node --env-file-if-exists=.env scripts/native-preflight.mjs",
    "verify:native:live": "node --env-file-if-exists=.env scripts/verify-native-live.mjs",
    "format": "prettier --write src server scripts tests docs README.md *.json *.ts",
    "format:check": "prettier --check src server scripts tests docs README.md *.json *.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "imapflow": "^2.9.1",
    "lucide-react": "0.468.0",
    "mailparser": "^3.12.3",
    "nodemailer": "^10.2.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

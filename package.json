{
  "name": "shadeflow-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "postinstall": "node scripts/check-docling.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server-render --emptyOutDir",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:rollback": "node scripts/release.mjs rollback",
    "schema:prepare": "node --env-file-if-exists=.env scripts/migrate-business-schema.mjs prepare",
    "schema:finalize": "node --env-file-if-exists=.env scripts/migrate-business-schema.mjs finalize",
    "business:provision": "node --env-file-if-exists=.env scripts/provision-customer-business.mjs",
    "test": "node --test tests/*.test.mjs",
    "preflight:native": "node --env-file-if-exists=.env scripts/native-preflight.mjs",
    "verify:native:live": "node --env-file-if-exists=.env scripts/verify-native-live.mjs",
    "verify:mail:knowledge": "node scripts/verify-mail-knowledge.mjs",
    "verify:mail:browser": "node scripts/verify-mail-browser.mjs",
    "verify:mail:internal": "node scripts/verify-mail-internal.mjs --live-internal",
    "benchmark:reply-reads": "node scripts/benchmark-reply-reads.mjs",
    "format": "prettier --write src server scripts tests docs README.md *.json *.ts",
    "format:check": "prettier --check src server scripts tests docs README.md *.json *.ts",
    "import:price-catalog": "node --env-file-if-exists=.env scripts/import-price-catalog.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@hyzyla/pdfium": "3.0.0",
    "@radix-ui/react-toggle-group": "1.2.1",
    "dompurify": "^3.4.17",
    "i18n-iso-countries": "7.14.0",
    "imapflow": "^2.9.1",
    "lucide-react": "0.468.0",
    "mailparser": "^3.12.3",
    "nodemailer": "^10.2.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "react-select": "5.10.2",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "playwright-core": "1.65.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

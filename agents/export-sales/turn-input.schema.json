{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "turn-input.schema.json",
  "title": "出口业务员 Agent 单轮业务上下文（审核与接管分离）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_id",
    "evaluation_time",
    "event",
    "conversation",
    "company_context",
    "mailbox_context",
    "demand_context",
    "drawing_context",
    "knowledge",
    "policy"
  ],
  "properties": {
    "contract_version": { "const": "1.3" },
    "agent_id": { "$ref": "#/definitions/agentId" },
    "evaluation_time": { "type": "string", "minLength": 1 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message_id", "text"],
      "properties": {
        "type": { "enum": ["inbound", "follow_up", "human_return"] },
        "message_id": { "type": ["string", "null"] },
        "text": { "type": "string" }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "customer_id",
        "channel",
        "language",
        "buyer_status",
        "history_summary",
        "ownership",
        "handoff_ack_sent"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "customer_id": { "type": ["string", "null"] },
        "channel": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "buyer_status": { "enum": ["b2b", "personal", "unknown"] },
        "history_summary": { "type": "string" },
        "ownership": { "enum": ["ai", "pending_human", "human"] },
        "handoff_ack_sent": { "type": "boolean" }
      }
    },
    "company_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "origin_country", "role", "approved_facts"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "origin_country": { "const": "CN" },
        "role": { "const": "exporter" },
        "approved_facts": {
          "type": "array",
          "items": { "$ref": "#/definitions/approvedKnowledge" }
        }
      }
    },
    "mailbox_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_id", "website_domain", "mailbox_id", "mailbox_address"],
      "properties": {
        "brand_id": { "type": "string", "minLength": 1 },
        "website_domain": { "type": "string", "minLength": 1 },
        "mailbox_id": { "type": "string", "minLength": 1 },
        "mailbox_address": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        }
      }
    },
    "demand_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product_agent_id",
          "lead_agent_id",
          "ownership",
          "purchase_purpose",
          "product_type",
          "product_access",
          "purchase_forms",
          "project_context",
          "facts",
          "missing_fields",
          "sales_stage",
          "handoff_ack_sent",
          "human_return_note",
          "repeated_negotiation",
          "nonprogress_exchanges",
          "large_order_match",
          "knowledge_resolution"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product_agent_id": {
            "anyOf": [{ "$ref": "#/definitions/agentId" }, { "type": "null" }]
          },
          "lead_agent_id": { "anyOf": [{ "$ref": "#/definitions/agentId" }, { "type": "null" }] },
          "ownership": { "enum": ["ai", "pending_human", "human"] },
          "purchase_purpose": { "enum": ["business", "personal", "unknown"] },
          "product_type": { "type": ["string", "null"] },
          "product_access": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "product_id", "source_id", "source_version"],
            "properties": {
              "scope": { "enum": ["website", "shared_catalog", "not_found", "unknown"] },
              "product_id": { "type": ["string", "null"], "minLength": 1 },
              "source_id": { "type": ["string", "null"], "minLength": 1 },
              "source_version": { "type": ["string", "null"], "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "scope": { "enum": ["website", "shared_catalog"] } } },
                "then": {
                  "properties": {
                    "product_id": { "type": "string" },
                    "source_id": { "type": "string" },
                    "source_version": { "type": "string" }
                  }
                }
              },
              {
                "if": { "properties": { "scope": { "const": "not_found" } } },
                "then": {
                  "properties": {
                    "product_id": { "type": "null" },
                    "source_id": { "type": "string" },
                    "source_version": { "type": "string" }
                  }
                }
              },
              {
                "if": { "properties": { "scope": { "const": "unknown" } } },
                "then": {
                  "properties": {
                    "product_id": { "type": "null" },
                    "source_id": { "type": "null" },
                    "source_version": { "type": "null" }
                  }
                }
              }
            ]
          },
          "purchase_forms": {
            "type": "array",
            "items": {
              "enum": [
                "finished",
                "semi_finished",
                "profiles",
                "components",
                "fabric",
                "motor",
                "control_system"
              ]
            },
            "uniqueItems": true
          },
          "project_context": {
            "enum": ["none", "institutional_indoor", "institutional_outdoor", "unknown"]
          },
          "facts": { "type": "object" },
          "missing_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "sales_stage": {
            "enum": [
              "qualification",
              "requirements",
              "selection",
              "quote_review",
              "sample",
              "follow_up",
              "negotiation_review",
              "won",
              "closed"
            ]
          },
          "handoff_ack_sent": { "type": "boolean" },
          "human_return_note": { "type": ["string", "null"] },
          "repeated_negotiation": { "type": "boolean" },
          "nonprogress_exchanges": { "type": "integer", "minimum": 0 },
          "large_order_match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["matched", "rule_id"],
            "properties": {
              "matched": { "type": "boolean" },
              "rule_id": { "type": ["string", "null"], "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "matched": { "const": true } } },
                "then": { "properties": { "rule_id": { "type": "string" } } },
                "else": { "properties": { "rule_id": { "type": "null" } } }
              }
            ]
          },
          "knowledge_resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "retrieval_state",
              "clarification_attempted",
              "unresolved_critical_question"
            ],
            "properties": {
              "retrieval_state": {
                "enum": ["not_needed", "not_attempted", "completed", "failed"]
              },
              "clarification_attempted": { "type": "boolean" },
              "unresolved_critical_question": { "type": "boolean" }
            }
          }
        }
      }
    },
    "drawing_context": { "$ref": "drawing-context.schema.json" },
    "knowledge": { "type": "array", "items": { "$ref": "#/definitions/approvedKnowledge" } },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "follow_up_enabled",
        "follow_up_intervals_days",
        "max_follow_ups",
        "send_window",
        "stagnation_exchange_threshold",
        "available_tools"
      ],
      "properties": {
        "follow_up_enabled": { "type": "boolean" },
        "follow_up_intervals_days": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "max_follow_ups": { "type": ["integer", "null"], "minimum": 1 },
        "stagnation_exchange_threshold": { "type": ["integer", "null"], "minimum": 1 },
        "send_window": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "timezone"],
              "properties": {
                "start": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
                "end": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
                "timezone": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "available_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "follow_up_enabled": { "const": true } } },
          "then": {
            "properties": {
              "follow_up_intervals_days": { "type": "array" },
              "max_follow_ups": { "type": "integer" },
              "send_window": { "type": "object" }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "agentId": { "enum": ["shutter", "venetian", "indoor", "outdoor"] },
    "approvedKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "content", "approved", "valid_until"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "anyOf": [{ "$ref": "#/definitions/agentId" }, { "type": "null" }] },
        "content": { "type": "string", "minLength": 1 },
        "approved": { "const": true },
        "valid_until": { "type": ["string", "null"] },
        "revision": { "type": "string", "minLength": 1 },
        "market": { "type": ["string", "null"] },
        "approved_use": {
          "type": "array",
          "items": { "enum": ["product_answer", "commercial_terms"] },
          "uniqueItems": true
        }
      }
    }
  }
}

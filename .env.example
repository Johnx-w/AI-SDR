# 仅服务端读取。不要使用 VITE_ 前缀存放密钥。
N8N_BASE_URL=https://vynox.app.n8n.cloud
N8N_WORKFLOW_ID=EycE9OmaPkRFUDSq
# 受 Header Auth 保护的生产 Webhook。不要填写编辑器 URL。
N8N_WEBHOOK_URL=
# 与 n8n Header Auth 凭证 X-Shadeflow-Key 的值一致。
N8N_WEBHOOK_SECRET=
# 完成 n8n 凭证保存与流程发布后，再改为 true。
N8N_WEBHOOK_ENABLED=false
# 可选：n8n Public API key。Codex 的 MCP OAuth 不会自动授权本应用。
N8N_API_KEY=
# 独立只读飞书客户接口，复用服务端 X-Shadeflow-Key。与获客写入工作流分离。
FEISHU_READ_WEBHOOK_URL=https://vynox.app.n8n.cloud/webhook/shadeflow-feishu-leads-read
PORT=4311
# DeepSeek 仅由本地 Node 服务读取，用于生成搜索词。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

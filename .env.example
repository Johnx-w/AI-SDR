# 仅服务端读取。不要使用 VITE_ 前缀存放密钥。
# n8n 保留兼容入口；完成 npm run preflight:native 后可切换为 native。
ACQUISITION_PROVIDER=n8n
TAVILY_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
# 正式入口默认 .data/acquisition.sqlite；任务和直连操作日志持久化。
BATCH_DB_PATH=.data/acquisition.sqlite
# 可选：独立评估数据库路径；不填时复用获客数据库，部署时须持久化备份。
ASSESSMENT_DB_PATH=
# 可选：独立的当前产品资料数据库；不填时复用获客数据库。
PRODUCT_KNOWLEDGE_DB_PATH=
# 可选：独立的客户会话、采购需求、沟通和跟进数据库。
CUSTOMER_BUSINESS_DB_PATH=
# 可选：业务表不确定写入的持久核对日志（仅后端读取）。
BUSINESS_MIRROR_JOURNAL_PATH=
# API 连接页的服务端覆盖配置；密钥不会回传浏览器。
CONNECTIONS_PATH=.data/api-connections.json
# 自动获客计划；本机后端持续运行时按北京时间触发。
SCHEDULE_DB_PATH=.data/acquisition-schedules.sqlite
N8N_BASE_URL=https://vynox.app.n8n.cloud
N8N_WORKFLOW_ID=EycE9OmaPkRFUDSq
# 受 Header Auth 保护的生产 Webhook。不要填写编辑器 URL。
N8N_WEBHOOK_URL=
# 与 n8n Header Auth 凭证 X-Shadeflow-Key 的值一致。
N8N_WEBHOOK_SECRET=
# 完成 n8n 凭证保存与流程发布后，再改为 true。
N8N_WEBHOOK_ENABLED=false
# 可选：n8n Public API key。Codex 的 MCP OAuth 不会自动授权本应用。
N8N_API_KEY=
# 独立只读飞书客户接口，复用服务端 X-Shadeflow-Key。与获客写入工作流分离。
FEISHU_READ_WEBHOOK_URL=https://vynox.app.n8n.cloud/webhook/shadeflow-feishu-leads-read
PORT=4311
# DeepSeek 仅由 Node 服务读取，用于 native 企业研究。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 检索与模型可独立替换；不填时继续使用上面的 Tavily/DeepSeek 凭证。
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
RESEARCH_MODEL_PROVIDER=deepseek
RESEARCH_MODEL_BASE_URL=
RESEARCH_MODEL_API_KEY=
RESEARCH_MODEL_MODEL=
# DeepSeek 推理强度 none/low/high/max；高强度会增加耗时，按真实质量验收选择。
RESEARCH_MODEL_REASONING_EFFORT=none
# 可选4096–65536；留空时none=16000、low=24000、high/max=48000，包含推理与最终答案。
RESEARCH_MODEL_MAX_OUTPUT_TOKENS=
# 可选海关发现：billofladingdata 或 http；http 地址为完整标准化 POST 端点。
CUSTOMS_PROVIDER=billofladingdata
CUSTOMS_BASE_URL=
CUSTOMS_API_KEY=
CUSTOMS_DB_PATH=.data/acquisition.sqlite
# 仅在验证供应商实际返回字段后配置，如 {"buyer_id":"import_id","buyer_address":"importer_address"}。
CUSTOMS_FIELD_MAP=

# 沟通中心单邮箱受控试点；仅允许固定公司测试地址，不能用于真实潜客发信。
# 用 .data/setup-mail-pilot.sh 在本机设置，勿把邮箱密码发到聊天或提交到 Git。
MAIL_ACCOUNT=SL01@shutterblindssolutions.com
MAIL_TEST_RECIPIENT=SL01@honeybadgerblinds.com
# 阿里邮箱新生成的、专供本机试点的第三方客户端安全密码。
MAIL_CLIENT_PASSWORD=
# 本机沟通中心操作者口令（至少 32 字符，区别于邮箱密码）。
MAIL_OPERATOR_TOKEN=
MAIL_DB_PATH=.data/mail-pilot.sqlite

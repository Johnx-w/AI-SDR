[Unit]
Description=ShadeFlow online SQLite backup

[Service]
Type=oneshot
ExecStart=/srv/shadeflow/ops/node /srv/shadeflow/ops/ops-backup.mjs
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/shadeflow
